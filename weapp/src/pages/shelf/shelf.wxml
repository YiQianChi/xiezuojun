<view class="page">
  <!-- 自绘标题栏：左上返回跟标题一体 -->
  <view class="navbar" style="padding-top:{{sbh}}px; padding-right:{{capsuleRight}}px;">
    <view class="nav-inner">
      <view class="nav-left">
        <view class="back-btn" bindtap="goBack">
          <view class="back-chev"></view>
        </view>
        <text class="nav-title">书架</text>
      </view>
      <view class="nav-actions">
        <text class="nav-act" bindtap="openTrash">回收站</text>
      </view>
    </view>
  </view>

  <view class="body">
    <view wx:if="{{loading}}" class="empty">加载中…</view>
    <view wx:elif="{{!projects.length}}" class="empty">
      <text>书架还是空的</text>
      <button class="btn primary sm" bindtap="openCreate">新建第一本书</button>
    </view>

    <view wx:else class="grid">
      <!-- 新建卡 -->
      <view class="card add-card" bindtap="openCreate">
        <view class="add-box"><view class="plus-h"></view><view class="plus-v"></view></view>
        <text class="add-text">新建作品</text>
      </view>
      <view class="card" wx:for="{{projects}}" wx:key="id"
            data-pid="{{item.public_id}}" bindtap="openBook">
        <view class="cover">
          <image wx:if="{{item.cover_url}}" src="{{item.cover_url}}" mode="aspectFill" class="cover-img" />
          <text wx:else class="cover-letter">{{item.name[0]}}</text>
        </view>
        <view class="card-info">
          <text class="card-name">{{item.name}}</text>
          <text class="card-meta">{{item.word_count ? item.word_count + ' 字' : '尚未开笔'}}</text>
        </view>
        <view class="card-acts">
          <text class="act" catchtap="startRename" data-id="{{item.id}}">重命名</text>
          <text class="act danger" catchtap="delBook" data-id="{{item.id}}">删除</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 新建弹窗 -->
  <view class="mask" wx:if="{{showCreate}}" catchtap="cancelCreate">
    <view class="dlg" catchtap="">
      <text class="dlg-title">新建作品</text>
      <input class="input" value="{{newName}}" bindinput="onName" placeholder="书名"
             placeholder-class="ph" maxlength="50" confirm-type="done" bindconfirm="createProject" />
      <view class="dlg-btns">
        <button class="btn ghost" catchtap="cancelCreate">取消</button>
        <button class="btn primary" disabled="{{creating || !newName.trim()}}" catchtap="createProject">
          {{creating ? '创建中…' : '创建'}}
        </button>
      </view>
    </view>
  </view>

  <!-- 重命名弹窗 -->
  <view class="mask" wx:if="{{renameTarget}}" catchtap="cancelRename">
    <view class="dlg" catchtap="">
      <text class="dlg-title">重命名</text>
      <input class="input" value="{{renameName}}" bindinput="onRename" placeholder="书名"
             placeholder-class="ph" maxlength="50" confirm-type="done" bindconfirm="doRename" />
      <view class="dlg-btns">
        <button class="btn ghost" catchtap="cancelRename">取消</button>
        <button class="btn primary" disabled="{{!renameName.trim()}}" catchtap="doRename">保存</button>
      </view>
    </view>
  </view>

  <!-- 回收站抽屉 -->
  <view class="mask" wx:if="{{showTrash}}" catchtap="closeTrash">
    <view class="sheet" catchtap="">
      <view class="sheet-head">
        <text class="sheet-title">回收站</text>
        <text class="sheet-empty-btn" wx:if="{{trash.length}}" bindtap="emptyTrash">清空</text>
      </view>
      <view wx:if="{{!trash.length}}" class="sheet-empty">回收站为空</view>
      <view class="sheet-item" wx:for="{{trash}}" wx:key="id">
        <view class="sheet-info">
          <text class="sheet-name">{{item.title}}</text>
        </view>
        <text class="act" data-id="{{item.project_id || item.id}}" catchtap="restoreBook">恢复</text>
        <text class="act danger" data-id="{{item.project_id || item.id}}" catchtap="destroyBook">删除</text>
      </view>
    </view>
  </view>
</view>
