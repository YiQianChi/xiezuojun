page { background: #f7f9f4; font-size: 14px; }
.page { display: flex; flex-direction: column; min-height: 100vh; }

.body { padding: 8px 16px 40px; }
.toolbar { display: flex; align-items: center; justify-content: space-between; padding: 4px 4px 10px; }
.tb-hint { font-size: 12px; line-height: 16px; height: 16px; color: #9aa094; white-space: nowrap; }
.tb-trash { font-size: 13px; line-height: 18px; color: #4a7a58; padding: 4px 2px; white-space: nowrap; }
.empty { padding: 80px 0; display: flex; flex-direction: column; align-items: center; gap: 16px; color: #9aa094; font-size: 14px; }

.grid { display: flex; flex-wrap: wrap; gap: 12px; }
.card {
  width: calc(50% - 6px); box-sizing: border-box; background: #fff; border-radius: 14px;
  border: 1px solid rgba(0,0,0,.04); overflow: hidden; display: flex; flex-direction: column;
}
.cover { width: 100%; height: 210rpx; background: #eef2ea; display: flex; align-items: center; justify-content: center; }
.cover-img { width: 100%; height: 100%; }
.cover-letter { font-size: 34px; color: #7c9b84; font-weight: 700; }
.card-info { padding: 8px 10px 2px; display: flex; flex-direction: column; gap: 2px; }
.card-name { font-size: 14px; line-height: 20px; height: 20px; color: #33302a; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.card-meta { font-size: 11px; line-height: 15px; height: 15px; color: #9aa094; white-space: nowrap; }
.card-acts { display: flex; border-top: 1px solid #f0f2ec; margin-top: 6px; }
.act { flex: 1; text-align: center; font-size: 12px; line-height: 17px; color: #4a7a58; padding: 8px 0; white-space: nowrap; }
.act.danger { color: #d05252; border-left: 1px solid #f0f2ec; }

.add-card { height: 300rpx; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 10px; border: 1px dashed #c3d2c6; background: rgba(255,255,255,.6); }
.add-box { width: 36px; height: 36px; border-radius: 50%; background: rgba(106,168,119,.12); position: relative; }
.plus-h, .plus-v { position: absolute; background: #4a7a58; border-radius: 1px; }
.plus-h { left: 10px; top: 17px; width: 16px; height: 2px; }
.plus-v { left: 17px; top: 10px; width: 2px; height: 16px; }
.add-text { font-size: 13px; line-height: 18px; color: #4a7a58; white-space: nowrap; }

.mask { position: fixed; inset: 0; background: rgba(30,34,28,.4); z-index: 50; display: flex; align-items: center; justify-content: center; }
.dlg { width: 78%; background: #fff; border-radius: 16px; padding: 22px 18px 16px; display: flex; flex-direction: column; gap: 14px; }
.dlg-title { font-size: 16px; font-weight: 700; color: #33302a; text-align: center; }
.input { background: #f4f6f1; border-radius: 10px; padding: 12px 14px; font-size: 15px; }
.ph { color: #c2c8bc; }
.dlg-btns { display: flex; gap: 10px; }
.btn { flex: 1; border-radius: 999px; font-size: 14px; padding: 0; margin: 0; border: none; }
.btn::after { border: none; }
.btn.ghost { background: #eef2ea; color: #4a4f45; height: 38px; line-height: 38px; }
.btn.primary { background: #6aa877; color: #fff; height: 38px; line-height: 38px; }
.btn.primary[disabled] { background: #b9d4bf; color: rgba(255,255,255,.8); }
.btn.sm { width: 160px; flex: none; }

/* 回收站底部抽屉 */
.sheet { position: absolute; left: 0; right: 0; bottom: 0; background: #fff; border-radius: 18px 18px 0 0; padding: 16px 16px 30px; max-height: 70vh; display: flex; flex-direction: column; }
.sheet-head { display: flex; align-items: center; justify-content: space-between; padding-bottom: 10px; border-bottom: 1px solid #f0f2ec; }
.sheet-title { font-size: 15px; font-weight: 700; color: #33302a; }
.sheet-empty-btn { font-size: 13px; color: #d05252; padding: 4px; }
.sheet-empty { padding: 40px 0; text-align: center; color: #9aa094; font-size: 13px; }
.sheet-item { display: flex; align-items: center; gap: 10px; padding: 12px 4px; border-bottom: 1px solid #f6f7f3; }
.sheet-info { flex: 1; overflow: hidden; }
.sheet-name { font-size: 14px; color: #33302a; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.sheet .act { flex: none; padding: 6px 12px; }
