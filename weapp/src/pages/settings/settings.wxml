<view class="page">
  <view class="card">
    <view class="row">
      <text class="label">账号</text>
      <text class="value">{{email || '-'}}</text>
    </view>
    <view class="row link" bindtap="openPwd">
      <text class="label">修改密码</text>
      <text class="arrow">›</text>
    </view>
    <view wx:if="{{showPwd}}" class="pwd-box">
      <input class="input" password value="{{pwd1}}" bindinput="onPwd1" placeholder="新密码（至少 6 位）" placeholder-class="ph" />
      <input class="input" password value="{{pwd2}}" bindinput="onPwd2" placeholder="再输入一次" placeholder-class="ph" />
      <button class="btn primary" disabled="{{saving}}" bindtap="savePwd">{{saving ? '保存中…' : '保存'}}</button>
    </view>
  </view>

  <view class="card">
    <view class="row link" bindtap="openAgreement">
      <text class="label">用户服务协议</text>
      <text class="arrow">›</text>
    </view>
    <view class="row link" bindtap="openPrivacy">
      <text class="label">隐私政策</text>
      <text class="arrow">›</text>
    </view>
    <view class="row">
      <text class="label">版本</text>
      <text class="value">{{version}}</text>
    </view>
  </view>

  <button class="logout" bindtap="logout">退出登录</button>
</view>
