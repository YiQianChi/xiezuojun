page { background: #f7f9f4; }
.page { padding: 14px 18px 40px; }
.card { background: #fff; border-radius: 14px; border: 1px solid rgba(0,0,0,.04); margin-bottom: 14px; overflow: hidden; }
.row { display: flex; align-items: center; justify-content: space-between; padding: 15px 16px; border-bottom: 1px solid #f4f6f0; }
.row:last-child { border-bottom: none; }
.row.link:active { background: #f8faf6; }
.label { font-size: 15px; color: #33302a; }
.value { font-size: 13px; color: #9aa094; }
.arrow { color: #c2c8bc; font-size: 18px; }
.pwd-box { padding: 4px 16px 16px; display: flex; flex-direction: column; gap: 10px; }
.input { background: #f4f6f1; border-radius: 10px; padding: 11px 14px; font-size: 14px; }
.ph { color: #c2c8bc; }
.btn { border-radius: 999px; font-size: 14px; margin: 0; border: none; }
.btn::after { border: none; }
.btn.primary { background: #6aa877; color: #fff; height: 38px; line-height: 38px; }
.btn.primary[disabled] { background: #b9d4bf; }
.logout { margin-top: 20px; background: #fff; color: #d05252; border-radius: 14px; font-size: 15px; border: 1px solid rgba(0,0,0,.04); }
.logout::after { border: none; }
