.login {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 160rpx;
}
.logo {
  font-size: 56rpx;
  font-weight: 700;
  color: #4a7a58;
}
.slogan {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #9aa89c;
}
.form {
  width: 600rpx;
  margin-top: 96rpx;
  display: flex;
  flex-direction: column;
  gap: 28rpx;
}
.input {
  background: #fff;
  border: 2rpx solid #e4ebe2;
  border-radius: 20rpx;
  padding: 26rpx 32rpx;
  font-size: 30rpx;
}
.ph { color: #c0c8c2; }
.btn {
  background: linear-gradient(135deg, #8fc59b, #6aa877);
  color: #fff;
  border-radius: 44rpx;
  font-size: 32rpx;
  font-weight: 600;
  border: none;
}
.btn-wx {
  background: #07c160;
  color: #fff;
  border-radius: 44rpx;
  font-size: 32rpx;
  font-weight: 600;
  border: none;
}
.divider {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: #c0c8c2;
  margin: 8rpx 0;
}
.btn-loading { opacity: .7; }
.legal { font-size: 12px; color: #8a8f85; text-align: center; margin-top: 14px; line-height: 1.7; }
.legal-link { color: #4a7c59; text-decoration: underline; }
.agree-row {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-wrap: wrap;
  margin-top: 14px;
  font-size: 12px;
  color: #8a8f85;
  line-height: 1.7;
}
.agree-box {
  width: 17px;
  height: 17px;
  border: 1.5px solid #b8c2ba;
  border-radius: 5px;
  margin-right: 6px;
  font-size: 12px;
  line-height: 16px;
  text-align: center;
  color: #fff;
  flex-shrink: 0;
}
.agree-box.on { background: #6aa877; border-color: #6aa877; }
.agree-text { color: #8a8f85; }
.reg {
  text-align: center;
  font-size: 26rpx;
  color: #6aa877;
  padding: 16rpx;
}
