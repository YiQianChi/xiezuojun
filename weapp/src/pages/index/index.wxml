<web-view wx:if="{{url}}" src="{{url}}" binderror="onError" bindmessage="onWebViewMsg"></web-view>

<view wx:if="{{loadFailed}}" class="fail">
  <view class="fail-icon">
    <!-- 细线断网图标（WXML 不支持 <svg>，走 base64 image） -->
    <image class="fail-svg" mode="aspectFit" src="data:image/svg+xml;base64," />
  </view>
  <view class="fail-title">连接不上服务器</view>
  <view class="fail-desc">请检查网络后重试</view>
  <button class="fail-btn" bindtap="onRetry">重试</button>
</view>
