.share-page {
  height: 100vh; background: #f5f5f7;
  display: flex; flex-direction: column; align-items: center; justify-content: center;
  padding: 0 24px; box-sizing: border-box;
}
.sp-card {
  width: 100%; background: #fff; border-radius: 18px; padding: 30px 24px;
  text-align: center; box-shadow: 0 2px 14px rgba(0,0,0,.06);
  overflow: hidden; /* 封面图贴圆角 */
}
.sp-cover { width: 100%; border-radius: 12px; margin-bottom: 16px; display: block; } /* widthFix 等比缩放不裁切（方图=宽高一致） */
.sp-code { font-size: 40px; font-weight: 800; letter-spacing: 8px; color: #1d1d1f; margin: 4px 0 2px; font-variant-numeric: tabular-nums; }
.sp-label { font-size: 13px; color: #86868b; margin-bottom: 14px; }
.sp-book { font-size: 13px; color: #86868b; }
.sp-title { font-size: 19px; font-weight: 700; color: #1d1d1f; margin: 6px 0 18px; }
.sp-tip { font-size: 13px; color: #86868b; margin-bottom: 16px; }
.sp-btn {
  background: #07c160; color: #fff; font-size: 16px; font-weight: 600;
  border-radius: 999px; width: 100%;
}
.sp-hint { font-size: 11px; color: #aeaeb2; margin-top: 12px; }
.sp-back { margin-top: 22px; font-size: 14px; color: #007aff; }
