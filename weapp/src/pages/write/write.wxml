<view class="page">
  <view class="head">
    <text class="ch-title" bindtap="toggleDrawer">{{cur ? cur.title : '选择章节'}} ▾</text>
    <text class="status">{{wc}} 字 · {{saving}}</text>
  </view>

  <textarea wx:if="{{cur}}" class="writer" value="{{text}}" bindinput="onInput"
            maxlength="-1" confirm-type="done" show-confirm-bar="{{false}}"
            placeholder="开始写这一章…" placeholder-class="ph"></textarea>
  <view wx:else class="empty" bindtap="toggleDrawer">
    <text>{{flatChapters.length ? '点这里选择章节' : '这本书还没有章节'}}</text>
    <button wx:if="{{!flatChapters.length}}" class="btn primary" bindtap="newChapter">建第一章</button>
  </view>

  <view class="foot">
    <text class="f-btn" bindtap="toggleDrawer">目录</text>
    <text class="f-btn" bindtap="newChapter">+ 新章</text>
    <text class="f-btn ghost" bindtap="fullEditor">完整编辑器 ›</text>
  </view>

  <!-- 章节抽屉 -->
  <view class="mask" wx:if="{{drawer}}" catchtap="toggleDrawer">
    <view class="sheet" catchtap="">
      <view class="sheet-head">
        <text class="sheet-title">{{bookName}}</text>
        <text class="sheet-new" bindtap="newChapter">+ 新章</text>
      </view>
      <scroll-view scroll-y class="sheet-scroll">
        <block wx:for="{{docs}}" wx:key="id" wx:for-item="node">
          <view wx:if="{{node.isVol}}" class="vol">{{node.title || '未分卷'}}</view>
          <view wx:else class="ch {{cur && cur.id === node.id ? 'on' : ''}}" data-id="{{node.id}}" catchtap="pickChapter">
            <text class="ch-name">{{node.title}}</text>
            <text class="ch-wc">{{node.word_count ? node.word_count + ' 字' : ''}}</text>
          </view>
          <view wx:for="{{node.children}}" wx:key="id" wx:for-item="c"
                class="ch {{cur && cur.id === c.id ? 'on' : ''}}" data-id="{{c.id}}" catchtap="pickChapter">
            <text class="ch-name">{{c.title}}</text>
            <text class="ch-wc">{{c.word_count ? c.word_count + ' 字' : ''}}</text>
          </view>
        </block>
      </scroll-view>
    </view>
  </view>
</view>
