page { background: #fbfaf6; height: 100%; }
.page { height: 100vh; display: flex; flex-direction: column; }
.state { flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 16px; color: #9aa094; font-size: 14px; }
.reader { flex: 1; padding: 20px 22px 40px; box-sizing: border-box; }
.meta { display: flex; flex-direction: column; align-items: center; gap: 6px; margin-bottom: 20px; }
.book { font-size: 13px; color: #9aa094; }
.title { font-size: 20px; font-weight: 700; color: #33302a; }
.sub { font-size: 12px; color: #b0b6aa; }
.para { font-size: 16px; line-height: 1.95; color: #3a372f; margin-bottom: 14px; text-indent: 2em; }
.end { text-align: center; color: #b0b6aa; font-size: 13px; margin: 26px 0; }
.cta { background: #fff; border-radius: 14px; border: 1px solid rgba(0,0,0,.04); padding: 20px; display: flex; flex-direction: column; align-items: center; gap: 12px; }
.cta-t { font-size: 14px; color: #4a4f45; }
.btn { border-radius: 999px; font-size: 14px; margin: 0; border: none; }
.btn::after { border: none; }
.btn.primary { background: #6aa877; color: #fff; height: 38px; line-height: 38px; width: 200px; }
.btn.ghost { background: #eef2ea; color: #4a4f45; height: 38px; line-height: 38px; width: 200px; }
